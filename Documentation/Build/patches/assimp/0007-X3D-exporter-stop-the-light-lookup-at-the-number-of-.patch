From 7b9a251674545ae671e267ddc8d49b8266033c2f Mon Sep 17 00:00:00 2001
From: HRConvert2 <hrconvert2@invalid>
Date: Fri, 20 Nov 2026 03:31:41 -0500
Subject: [PATCH 07/10] X3D exporter: stop the light lookup at the number of
 lights

The loop's condition was mScene->mNumLights, which never ends a scene with a light, so a node not named for one read past the list.
---
 code/AssetLib/X3D/X3DExporter.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/code/AssetLib/X3D/X3DExporter.cpp b/code/AssetLib/X3D/X3DExporter.cpp
index 0c5ed126..375ee6ed 100644
--- a/code/AssetLib/X3D/X3DExporter.cpp
+++ b/code/AssetLib/X3D/X3DExporter.cpp
@@ -576,7 +576,7 @@ bool X3DExporter::CheckAndExport_Light(const aiNode &pNode, const size_t pTabLev
     if (pNode.mName.length == 0) return false;
 
     // search for light with name like node has.
-    for (idx_light = 0; mScene->mNumLights; idx_light++) {
+    for (idx_light = 0; idx_light < mScene->mNumLights; idx_light++) {
         if (pNode.mName == mScene->mLights[idx_light]->mName) {
             found = true;
             break;
