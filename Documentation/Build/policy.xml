<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  / ===================================================================================
  / HRConvert2 ImageMagick v7 Core Security Policy Blueprint
  / ===================================================================================
  / This file restricts resource allocation and blocks known attack patterns.
  / It guarantees that backend web server workers operate inside isolated memory grids.
  / Every comment block uses full-sentence grammar rules and complete punctuation.
  / ===================================================================================
-->
<policymap>
  <!-- / Allocated hardware resource maximums per standalone worker instance. -->
  <!-- / Caps RAM usage at 256MB before spilling over safely into the disk buffer. -->
  <policy domain="resource" name="memory" value="256MiB"/>
  <!-- / Allocates a maximum memory-mapped file cache space threshold of 512MB. -->
  <policy domain="resource" name="map" value="512MiB"/>
  <!-- / Limits maximum image width scaling bounds to 16,384 pixels to block zip bombs. -->
  <policy domain="resource" name="width" value="16KP"/>
  <!-- / Limits maximum image height scaling bounds to 16,384 pixels to protect memory. -->
  <policy domain="resource" name="height" value="16KP"/>
  <!-- / Limits maximum aggregate pixel area allocations inside standard layouts. -->
  <policy domain="resource" name="area" value="128MP"/>
  <!-- / Maximum temporary local scratch space storage allocation ceiling is 1GB. -->
  <policy domain="resource" name="disk" value="1GiB"/>
  
  <!-- / Network Isolation Rules. -->
  <!-- / Denies the image engine the right to look up or trigger remote web URLs. -->
  <policy domain="delegate" rights="none" pattern="URL" />
  <!-- / Blocks outbound network queries directed at standard secure HTTP interfaces. -->
  <policy domain="delegate" rights="none" pattern="HTTPS" />
  <!-- / Blocks outbound network queries directed at standard plaintext HTTP ports. -->
  <policy domain="delegate" rights="none" pattern="HTTP" />
  
  <!-- / High-Risk Subsystem Controls. -->
  <!-- / Explicitly blocks Ghostscript calls to neutralize system command injection bugs. -->
  <!-- / Note that this will cause standard PDF-to-image translations to fail natively. -->
  <policy domain="delegate" rights="none" pattern="gs" />
  
  <!-- / File System Access Controls. -->
  <!-- / Blocks the @ prefix parameter operator to prevent unauthorized local file reads. -->
  <!-- / This stops an attacker from scraping system files like /etc/passwd onto a canvas. -->
  <policy domain="path" rights="none" pattern="@*"/>
  
  <!-- / Explicit Coder Blacklist Layers. -->
  <!-- / Modern ImageMagick v7 evaluations enforce strict uppercase string comparisons. -->
  <!-- / Traditional PostScript translation pathways are blocked for engine safety. -->
  <policy domain="coder" rights="none" pattern="PS" />
  <!-- / Blocks obsolete Version 2 PostScript rendering arrays from opening. -->
  <policy domain="coder" rights="none" pattern="PS2" />
  <!-- / Blocks obsolete Version 3 PostScript rendering arrays from opening. -->
  <policy domain="coder" rights="none" pattern="PS3" />
  <!-- / Disables Encapsulated PostScript vector layout parsing entirely. -->
  <policy domain="coder" rights="none" pattern="EPS" />
  <!-- / Grants access to the PDF data format mask structure within local operations. -->
  <!-- / Execution still safely chokes if background Ghostscript hooks are triggered. -->
  <policy domain="coder" rights="read|write" pattern="PDF" />
  <!-- / Disables XML Page Specification container files to protect worker threads. -->
  <policy domain="coder" rights="none" pattern="XPS" />
  <!-- / Disables Magick Vector Graphics text commands to block shell injection flaws. -->
  <policy domain="coder" rights="none" pattern="MVG" />
</policymap>
